<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/oobe_original_accent_disabled" />
            <corners android:radius="@dimen/oobe_original_action_corner" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/oobe_original_accent_pressed" />
            <corners android:radius="@dimen/oobe_original_action_corner" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/oobe_original_accent" />
            <corners android:radius="@dimen/oobe_original_action_corner" />
        </shape>
    </item>
</selector>
